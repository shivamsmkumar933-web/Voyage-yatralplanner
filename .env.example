# ==============================================================================
# SECURE TRAVEL & DISCOVERY API CONFIGURATION
# Keys and secrets are never hardcoded in source code.
# The Secrets Gradle Plugin reads these into BuildConfig at compile time.
# In production, route requests through your secure backend proxy URL.
# ==============================================================================

# 1. Unified / All-in-One API Key (Private & Encrypted):
# If you have one unified key that has all access (e.g. SerpApi / Amadeus / RapidAPI / Proxy),
# configure it here or securely in the in-app password vault:
TRAVEL_ALL_IN_ONE_API_KEY=PLACEHOLDER_KEY

# 2. Backend Proxy URL (Recommended for production):
# When set, the app sends search requests to your serverless proxy / backend,
# keeping third-party vendor keys completely hidden from client traffic.
TRAVEL_BACKEND_PROXY_URL=https://api.example.com

# 3. Individual Provider Keys (Optional fallback):
GOOGLE_PLACES_API_KEY=PLACEHOLDER_KEY
TRIPADVISOR_API_KEY=PLACEHOLDER_KEY
AMADEUS_API_KEY=PLACEHOLDER_KEY
AMADEUS_API_SECRET=PLACEHOLDER_SECRET
